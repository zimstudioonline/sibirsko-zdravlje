{
  "name": "sibirsko-zdravlje",
  "version": "0.6.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "local:setup": "bun scripts/local-setup.ts",
    "local:stop": "bunx supabase stop",
    "db:migrate": "bun packages/db/src/migrate.ts",
    "db:seed": "bun packages/db/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "2.10.6",
    "typescript": "5.9.3"
  }
}
