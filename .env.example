# LOKALNI RAZVOJ: ne popunjavaj ručno — `bun run local:setup` podiže Supabase
# u Dockeru i sam upisuje ove vrednosti u .env. Ručno popunjavaš tek za
# produkciju (pravi Supabase projekat).
#
# ── Supabase (Dashboard → Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role kljuc — SAMO server, nikad NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Baza (Dashboard → Project Settings → Database → Connection string) ────────
# OBAVEZNO pooler string u transaction modu (port 6543) zbog serverless-a na Vercelu.
DATABASE_URL=postgresql://postgres.xxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Sajt ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Analytics 4 (analytics-google) ──
# GA4 Measurement ID (Admin → Data Streams). Bez vrednosti se skripta ne učitava.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Meta Pixel (analytics-meta-pixel) ──
# Pixel ID (Meta Events Manager). Bez vrednosti se skripta ne učitava.
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# ── Katalog / upit za proizvode (marketing) ──────────────────────────────────
# Broj za Viber dugme — bez "+" i vodećih nula.
NEXT_PUBLIC_VIBER_NUMBER=381616598108
NEXT_PUBLIC_CONTACT_EMAIL=zdravljeisibir@gmail.com
# Google Apps Script Web App URL koji prima upite sa forme — vidi
# apps/marketing/google-apps-script/SETUP.md za podešavanje. Bez vrednosti
# forma prikazuje poruku da trenutno nije dostupna.
NEXT_PUBLIC_INQUIRY_FORM_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# @ludus:inject:env:example
